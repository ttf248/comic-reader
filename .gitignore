# ============================================
# 本地画廊 Web 版 - Git 忽略配置
# ============================================

# ----- Go -----
# 编译产物
/bin/
/build/
*.exe
*.exe~

# 第三方可执行(由 scripts/install-ffmpeg.bat 绿色安装)
/bin/ffmpeg/
*.dll
*.so
*.dylib

# 测试覆盖率
*.out
coverage.html
coverage.txt

# Go workspace
go.work
go.work.sum

# ----- Node / Frontend -----
node_modules/
.pnp
.pnp.js

# 构建产物
/frontend/dist/
/frontend/build/
/frontend/.vite/
# Vite 加载 TS 配置时的临时文件（跑一次 dev 或 build 就会生成）
/frontend/vite.config.ts.timestamp-*.mjs
/artifacts/
/frontend/coverage/
/frontend/test-results/
/frontend/playwright-report/

# 依赖锁（可选，按团队约定）
# package-lock.json
# pnpm-lock.yaml
# yarn.lock

# ----- 环境与配置 -----
.env
.env.local
.env.*.local

# 后端配置（实际部署时填写，从 config.example.yaml 复制）
backend/config.yaml
backend/test-config.yaml

# ----- IDE -----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~
.DS_Store

# ----- OS -----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- 日志与临时 ----
*.log
*.tmp
*.bak

# ----- 测试与文档产物 ----
/tmp/
/test-results/
/playwright-report/
/playwright/.cache/
# 集成测试夹具(视频/图片)不进仓 — 在 .gitignore 里屏蔽整个 testdata 目录,
# 真要保留 fixture 的话用专门的 git-lfs 或独立 fixtures 仓库。
/tests/integration/testdata/

# ----- 烟测 / 调试脚本运行产物 ----
# 脚本运行产生的临时文件、截图与进程日志
.smoke/

# ----- 缓存目录（运行时生成，不入仓）-----
# 注：服务运行时会重建这些目录
.local-gallery/
# 历史遗留：老版本缓存目录，新版本已迁到 .local-gallery/
.image-viewer/
.comic-reader/
# 用户 config.yaml 写错 cacheDir 拼写(少 r)产生的实际目录
.image-viewe/
.cache/
/backend/aiworker/.venv/
__pycache__/
*.tsbuildinfo
backend/config.local.yaml

# 临时 API 导出 / 调试快照(无对应代码写入,但确实会出现在仓库根)
.library.json

# 本地扫描测试用的临时媒体根(100 张 hash 文件名 jpg) — 不入仓
# 真要保留 fixture 放 tests/integration/testdata/ 并用 git-lfs
/testdata-comics/
