{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: tidy",
      "type": "shell",
      "command": "go mod tidy",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "backend: build",
      "type": "shell",
      "command": "go build -o ../bin/local-gallery ./cmd/server",
      "windows": {
        "command": "go build -o ../bin/local-gallery.exe ./cmd/server"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "build: local",
      "type": "shell",
      "command": "npm run build && mkdir -p bin && cd backend && go build -o ../bin/local-gallery ./cmd/server",
      "windows": {
        "command": ".\\scripts\\build.bat",
        "args": ["--local", "--skip-install", "--no-pause"]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": "go test ./...",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "frontend: test",
      "type": "shell",
      "command": "npm run test",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "dev: all",
      "dependsOn": ["backend: tidy", "frontend: install"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "build: all",
      "type": "shell",
      "command": "npm run build && mkdir -p bin && cd backend && go build -o ../bin/local-gallery ./cmd/server",
      "windows": {
        "command": ".\\build.bat",
        "args": ["--no-pause"]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
