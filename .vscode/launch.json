{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1) 后端: Go (Fiber)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/server",
      "cwd": "${workspaceFolder}/backend",
      "args": ["--config", "config.yaml"],
      "console": "integratedTerminal",
      "preLaunchTask": "backend: tidy"
    },
    {
      "name": "2) 前端: Vite Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "${workspaceFolder}/frontend"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "3) 运行本机最新构建",
      "type": "node-terminal",
      "request": "launch",
      "command": "../bin/local-gallery --config config.yaml",
      "windows": { "command": "../bin/local-gallery.exe --config config.yaml" },
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "build: local"
    },
    {
      "name": "4) 后端: 调试服务测试",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/backend/internal/services",
      "cwd": "${workspaceFolder}/backend",
      "args": ["-test.v"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "全栈复合调试",
      "configurations": ["1) 后端: Go (Fiber)", "2) 前端: Vite Dev Server"],
      "stopAll": true
    }
  ]
}
